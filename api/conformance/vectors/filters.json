{
  "description": "Filter strings against the reference collection. 'valid' must be accepted (400 never returned); 'invalid' must return 400 with type .../bad-request.",
  "collection": {
    "name": "tasks",
    "fields": [
      { "name": "title", "type": "text" },
      { "name": "status", "type": "select", "values": ["open", "done"] },
      { "name": "priority", "type": "number" },
      { "name": "done", "type": "bool" },
      { "name": "due", "type": "date" },
      { "name": "owner", "type": "relation", "collection": "users" },
      { "name": "watchers", "type": "relation", "collection": "users", "maxSelect": 5 },
      { "name": "note", "type": "text", "hidden": true }
    ]
  },
  "valid": [
    "",
    "status = 'open'",
    "status in ('open', 'done') && priority >= 2",
    "title:lower ~ 'airport' || done = true",
    "due > '2026-01-01' && due <= @now",
    "owner = null || owner != ''",
    "watchers ?= '00000000000000000000000000' || watchers = null",
    "(priority > 1 || priority < -1) && title !~ '%'"
  ],
  "invalid": [
    "status =",
    "title = 1",
    "done > true",
    "priority ~ 2",
    "due = 'yesterday'",
    "missing = 1",
    "note = 'x'",
    "tags ?= 'x'",
    "status ?= 'open'"
  ]
}
