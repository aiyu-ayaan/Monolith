{
  "name": "monolith",
  "version": "0.0.0",
  "private": true,
  "description": "Monolith monorepo workspace for admin UI, SDKs, and web examples",
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "setup": "pnpm install",
    "dev": "node tools/dev.mjs",
    "dev:server": "cargo run -p monolith-server",
    "dev:ui": "pnpm --filter @monolith/ui dev",
    "build": "pnpm build:js && pnpm rust:build",
    "build:release": "pnpm build:js && pnpm rust:release",
    "build:js": "pnpm -r run build",
    "build:ui": "pnpm --filter @monolith/ui build",
    "build:sdk": "pnpm --filter @monolith/client build",
    "start": "pnpm build:ui && cargo run --release -p monolith-server",
    "test": "pnpm test:js && pnpm rust:test",
    "test:js": "pnpm -r run test",
    "test:sdk": "pnpm --filter @monolith/client test",
    "lint": "pnpm rust:lint && pnpm typecheck:ui",
    "fmt": "pnpm rust:fmt",
    "typecheck:ui": "pnpm --filter @monolith/ui typecheck",
    "rust:build": "cargo build --workspace",
    "rust:release": "cargo build --release --workspace",
    "rust:test": "cargo test --workspace",
    "rust:fmt": "cargo fmt --all",
    "rust:lint": "cargo fmt --all -- --check && cargo clippy --workspace --all-targets -- -D warnings",
    "rust:bench": "cargo bench --workspace",
    "rust:bench:build": "cargo bench --workspace --no-run",
    "rust:deny": "cargo deny check",
    "bench:engine": "cargo run --release -p monolith-bench --",
    "clean": "pnpm -r --parallel exec rm -rf dist node_modules"
  }
}
