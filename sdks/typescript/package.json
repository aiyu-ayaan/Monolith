{
  "name": "@monolith/client",
  "version": "0.0.0",
  "description": "Monolith client SDK: auth, records, realtime, offline sync, analytics, files",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./sync": {
      "types": "./dist/sync.d.ts",
      "import": "./dist/sync.js"
    },
    "./react-native": {
      "types": "./dist/rn.d.ts",
      "import": "./dist/rn.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup src/index.ts src/sync.ts src/rn.ts --format esm,cjs && tsc --emitDeclarationOnly",
    "test": "vitest run",
    "conformance": "vitest run test/conformance",
    "gen": "openapi-typescript ../../api/openapi/monolith.v1.yaml -o src/http/schema.gen.ts"
  },
  "devDependencies": {
    "@typescript/typescript6": "^6.0.2",
    "openapi-typescript": "^7.13.0",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
